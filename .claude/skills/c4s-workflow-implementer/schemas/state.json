{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state",
  "description": "The loop's machine state (.c4s-impl/state.json). Parsed once from the brief at setup; afterwards written only by the orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "units",
    "waves",
    "conventions",
    "iteration",
    "entityTypes"
  ],
  "properties": {
    "iteration": {
      "type": "integer"
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "key",
          "offset"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "description": "0-based section position at <to>"
          },
          "anchor": {
            "type": "string"
          }
        }
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "units"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startCommit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "systemVerified": {
      "type": "boolean"
    },
    "errors": {
      "type": "integer",
      "description": "consecutive error exits, reset on progress"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "recipe",
          "dependsOn",
          "wave",
          "status",
          "portions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "recipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pages",
              "entities"
            ],
            "description": "the brief's Read: lines, parsed; reading-the-spec.md turns them into c4s release-diff commands",
            "properties": {
              "pages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "<rootId>/<path>"
                    },
                    "change": {
                      "anyOf": [
                        {
                          "const": "all"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "offset",
                            "limit"
                          ],
                          "properties": {
                            "offset": {
                              "type": "integer",
                              "description": "0-based position among this read's sections[]"
                            },
                            "limit": {
                              "type": "integer"
                            },
                            "anchors": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "labels to check the read against, not the address"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "read --from <from>; numbers count the changed sections only. Absent in an initial window"
                    },
                    "context": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "offset",
                            "limit"
                          ],
                          "properties": {
                            "offset": {
                              "type": "integer",
                              "description": "0-based position among this read's sections[]"
                            },
                            "limit": {
                              "type": "integer"
                            },
                            "anchors": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "labels to check the read against, not the address"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "read --from initial; numbers count every section at <to>. An initial window's `sections:` lands here"
                    },
                    "deferred": {
                      "type": "array",
                      "description": "parts of this read the unit must not build yet (the brief's `not yet:`)",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "what",
                          "to"
                        ],
                        "properties": {
                          "what": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string",
                            "description": "the later unit that completes it"
                          },
                          "why": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "completes": {
                      "type": "array",
                      "description": "parts deferred to this unit by an earlier one (the brief's `completes:`)",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "what",
                          "from"
                        ],
                        "properties": {
                          "what": {
                            "type": "string"
                          },
                          "from": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "slugs"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "entity type, as the brief's line names it; its role is in entityTypes"
                    },
                    "slugs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "deferred": {
                      "type": "array",
                      "description": "parts of this read the unit must not build yet (the brief's `not yet:`)",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "what",
                          "to"
                        ],
                        "properties": {
                          "what": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string",
                            "description": "the later unit that completes it"
                          },
                          "why": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "completes": {
                      "type": "array",
                      "description": "parts deferred to this unit by an earlier one (the brief's `completes:`)",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "what",
                          "from"
                        ],
                        "properties": {
                          "what": {
                            "type": "string"
                          },
                          "from": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit"
              ],
              "properties": {
                "unit": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "wave": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "in-progress",
              "verified",
              "blocked"
            ]
          },
          "blockedBy": {
            "type": [
              "string",
              "null"
            ],
            "description": "a deviation id, 'stuck' or 'review'"
          },
          "startCommit": {
            "type": [
              "string",
              "null"
            ],
            "description": "HEAD the next review reads from; moved to HEAD at every reopen"
          },
          "baseCommit": {
            "type": [
              "string",
              "null"
            ],
            "description": "HEAD when the unit started; never moved. verify(u) squashes baseCommit..HEAD into one unit commit"
          },
          "portions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "slugs",
                "status",
                "rounds"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "<unit>/p1-l1"
                },
                "layers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "slugs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "enum": [
                    "pending",
                    "in-progress",
                    "implemented"
                  ],
                  "description": "in-progress: an implementer run on it started and did not finish; implemented: a run finished it. Only the unit-scope verifier checks it"
                },
                "rounds": {
                  "type": "integer",
                  "description": "implementer runs that finished the portion"
                },
                "partial": {
                  "type": "integer",
                  "description": "consecutive implementer runs that stopped early on the portion; reset when one finishes"
                },
                "uncovered": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "only": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "slug": {
                        "type": "string"
                      },
                      "finding": {
                        "type": "string"
                      }
                    },
                    "description": "one open item: { slug } from a unit-verifier row, or { finding } — a blocking review finding id"
                  }
                },
                "criteriaGroup": {
                  "type": "string"
                }
              }
            }
          },
          "only": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slug": {
                  "type": "string"
                },
                "finding": {
                  "type": "string"
                }
              },
              "description": "one open item: { slug } from a unit-verifier row, or { finding } — a blocking review finding id"
            },
            "description": "unit-scope items a reopen carries"
          },
          "rounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "review": {
                "type": "integer"
              },
              "unit": {
                "type": "integer"
              }
            }
          },
          "lastBlocking": {
            "type": "integer",
            "description": "blocking findings in the last review round — the 'did not shrink' test"
          },
          "lastUncovered": {
            "type": "integer",
            "description": "failed rows in the last unit-verifier round — the 'did not shrink' test for stuck"
          },
          "jobs": {
            "type": "array",
            "description": "setup step 4: the user jobs this unit owns — it is the last unit, in wave order, that reads a module the job names. The unit writes one end-to-end test per job, and the unit verifier checks it as job:<id>",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "modules"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "baselineGreen": {
      "type": "boolean",
      "description": "startMode resume: the full suite was green before the first unit"
    },
    "entityTypes": {
      "type": "array",
      "description": "setup step 5: the project's entity types the recipes read, and how each is built and verified in this repo",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "role"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "role": {
            "enum": [
              "criteria",
              "built",
              "context",
              "per-entity"
            ],
            "description": "per-entity: each entity of the type is classified on its own, in entityParts"
          },
          "checks": {
            "type": "string",
            "description": "criteria: the link field naming the entities a criterion checks"
          },
          "inCode": {
            "type": "string",
            "description": "built: the counterpart in this repo"
          },
          "verify": {
            "type": "string",
            "description": "built: the test that proves the counterpart has the entity's shape, and where it lives"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "link fields assembleSlice follows"
          },
          "inactive": {
            "type": "string",
            "description": "field = value that retires an entity, e.g. status = <value>"
          },
          "version": {
            "type": "integer",
            "description": "the catalog's payloadVersion this plan was made against"
          },
          "observedIn": {
            "enum": [
              "unit",
              "e2e",
              "per-criterion"
            ],
            "description": "criteria: where a criterion's observable lives — unit (in code, a test without the running app), e2e (what a user sees or does, a test against the running app), per-criterion (each criterion's title says which)"
          }
        }
      }
    },
    "entityParts": {
      "type": "array",
      "description": "setup step 5: one entry per entity of a per-entity type a recipe names — which parts of it are criteria, built or context. Decided once at set-up, confirmed by the user; the loop only reads it",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "type",
          "parts",
          "why"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "items"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "criteria",
                    "built",
                    "context"
                  ]
                },
                "items": {
                  "type": "string",
                  "description": "'all', or which rows, columns or entries the part covers, so that any reader of the entity finds the same ones"
                },
                "key": {
                  "type": "string",
                  "description": "what names one item (a label column, an entry's name); a multi-item part is verified per item, addressed <slug>#<key value>"
                },
                "inCode": {
                  "type": "string",
                  "description": "built: the counterpart of one item in this repo"
                },
                "verify": {
                  "type": "string",
                  "description": "built: the test that proves an item's counterpart, and where it lives"
                }
              }
            }
          }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "description": "the app the orchestrator last brought up (build.app), and its smoke result",
      "properties": {
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "description": "HEAD the app was brought up from"
        },
        "smokeGreen": {
          "type": "boolean"
        }
      }
    }
  }
}
