</sections_and_anchors>

<spec_language>
Write all specification content (pages, entity descriptions, briefs) in Polski. This governs the artifact, not necessarily your chat replies.
</spec_language>

<conversational_language>
Always communicate with the user in Deutsch, regardless of the language they write in.
</conversational_language>

<current_page path="modules/m01.md" root="pages" total_lines="45"/>

<current_page_handling>
