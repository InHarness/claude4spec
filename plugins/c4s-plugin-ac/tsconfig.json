{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    /*
     * The envelope resolves the Host API from the surrounding repo. An external
     * plugin gets the same names from its `@inharness-ai/claude4spec`
     * devDependency via `/// <reference types=".../plugin-runtime/ambient" />`;
     * swapping these two entries for that line is the whole compile-time delta
     * between this package and the same package extracted to its own repo. No
     * import in `src/` changes either way.
     */
    "paths": {
      "@c4s/plugin-runtime": ["../../src/plugin-types/plugin-runtime.ts"],
      "@c4s/plugin-runtime/ui": ["../../src/plugin-types/ui.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
