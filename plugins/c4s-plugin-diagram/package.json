      "default": "./dist/frontend.js"
    }
  },
  "peerDependencies": {
    "@c4s/plugin-runtime": "*",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@c4s/plugin-runtime": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
