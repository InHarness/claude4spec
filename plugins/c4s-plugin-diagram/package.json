{
  "name": "@inharness-ai/c4s-plugin-diagram",
  "version": "0.1.0",
  "description": "claude4spec plugin contributing the `diagram` entity type — a Mermaid diagram kept as a record and embedded in specification pages.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
