{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release",
  "description": "The window every read is pinned to, and the build's choices. Written once at setup (.c4s-impl/release.json); never edited by a role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "workspace",
    "from",
    "to",
    "brief",
    "harness",
    "build"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "description": "from_release, or the literal 'initial' for an initial window"
    },
    "to": {
      "type": "string"
    },
    "brief": {
      "type": "string",
      "description": "the brief path as c4s list-briefs prints it"
    },
    "harness": {
      "enum": [
        "claude-code-session",
        "claude-code-headless",
        "codex",
        "stub"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "isolation",
        "budget",
        "gates",
        "review",
        "startMode"
      ],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suite",
            "filtered"
          ],
          "properties": {
            "suite": {
              "type": "string"
            },
            "filtered": {
              "type": "string",
              "description": "contains <pattern>"
            },
            "e2e": {
              "type": "string",
              "description": "end-to-end tests against the running app; contains <url>, may contain <pattern>"
            },
            "smoke": {
              "type": "string",
              "description": "proves the app at <url> is up and usable; exit 0 is green"
            }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "worktree",
                "container",
                "main-checkout"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packetKB": {
              "type": "integer"
            },
            "implementer": {
              "type": "integer"
            },
            "verifier": {
              "type": "integer"
            },
            "reviewer": {
              "type": "integer"
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review": {
          "enum": [
            "off",
            "per-unit",
            "per-wave"
          ]
        },
        "reviewer": {
          "type": "string",
          "description": "same-harness, or a harness name"
        },
        "verifierTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startMode": {
          "enum": [
            "greenfield",
            "resume"
          ]
        },
        "waiting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipient": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            }
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "integer"
            }
          }
        },
        "stuckRounds": {
          "type": "integer"
        },
        "app": {
          "type": "string",
          "description": "none · command:<cmd> (prints the base URL as its last output line) · skill:<name> (session harness only)"
        },
        "appDown": {
          "type": "string",
          "description": "keep · command:<cmd>"
        }
      }
    }
  }
}
